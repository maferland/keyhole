function esc(s) {
  return s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
}
function render(template, slots) {
  return template.replace(/\{(\w+)\}/g, (match, key) => (key in slots) ? slots[key] : match);
}

// src/receipt.ts
var RECEIPT_SCHEMA = "keyhole.secret_reference_receipt.v1";
function buildReceipt(secrets, context) {
  return {
    schema: RECEIPT_SCHEMA,
    keyhole: package_default.version,
    request_id: randomBytes(8).toString("hex"),
    created_at: new Date().toISOString(),
    context,
    secrets: secrets.map(({ name, dest, retrieve }) => ({ name, dest, retrieve }))
  };
}
function writeReceipt(path, receipt) {
  writeAtomic0600(path, JSON.stringify(receipt, null, 2) + `
`);
}


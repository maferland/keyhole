#!/usr/bin/env node

// src/cli.ts
import { spawn } from "node:child_process";

// src/receipt.ts
import { randomBytes } from "node:crypto";

// src/stores.ts
import { spawnSync } from "node:child_process";
import {
  closeSync,
  constants as FS,
  existsSync,
  fchmodSync,
  mkdirSync,
  openSync,
  readFileSync,
  renameSync,
  writeSync
} from "node:fs";
import { homedir, userInfo } from "node:os";
import { dirname } from "node:path";

class ValidationError extends Error {
}
var ENV_NAME = /^[A-Za-z_][A-Za-z0-9_]*$/;
var defaultRunner = (cmd, args, stdin) => {
  const r = spawnSync(cmd, args, { encoding: "utf8", input: stdin });
  return { status: r.status, stderr: r.stderr ?? "" };
};
function storeKeychain(service, value, run = defaultRunner) {
  if (/[\n\r]/.test(value))
    throw new ValidationError("keychain: cannot store a value containing newlines");
  const account = userInfo().username;
  const r = run("security", ["add-generic-password", "-U", "-a", account, "-s", service, "-w"], `${value}
${value}
`);
  if (r.status !== 0)
    throw new Error(`keychain store failed (security exit ${r.status})`);
  return `security find-generic-password -s ${service} -a ${account} -w`;
}
function expandHome(path) {
  return path.startsWith("~/") ? homedir() + path.slice(1) : path;
}
function ensureParent(path) {
  mkdirSync(dirname(path) || ".", { recursive: true, mode: 448 });
}
function open0600(path) {
  const fd = openSync(path, FS.O_WRONLY | FS.O_CREAT | FS.O_TRUNC | FS.O_NOFOLLOW, 384);
  fchmodSync(fd, 384);
  return fd;
}
function readNoFollow(path) {
  const fd = openSync(path, FS.O_RDONLY | FS.O_NOFOLLOW);
  try {
    return readFileSync(fd, "utf8");
  } finally {
    closeSync(fd);
  }
}
function writeFd(fd, data) {
  try {
    writeSync(fd, data);
  } finally {
    closeSync(fd);
  }
}
function writeAtomic0600(path, data) {
  path = expandHome(path);
  ensureParent(path);
  const tmp = `${path}.keyhole-${process.pid}`;
  writeFd(open0600(tmp), data);
  renameSync(tmp, path);
}
function storeFile(path, value) {
  path = expandHome(path);
  ensureParent(path);
  writeFd(open0600(path), value);
  return path;
}
function storeEnv(name, path, value) {
  if (!ENV_NAME.test(name))
    throw new ValidationError(`env: invalid variable name '${name}'`);
  if (/[\n\r]/.test(value))
    throw new ValidationError("env: cannot store a value containing newlines");
  path = expandHome(path);
  const kept = existsSync(path) ? readNoFollow(path).split(`
`).filter(Boolean).filter((line) => line.split("=", 1)[0] !== name).map((line) => line + `
`).join("") : "";
  writeAtomic0600(path, kept + `${name}=${value}
`);
  return `set -a; source ${path}; set +a   # then \${${name}}`;
}
function keychainService(name, dest) {
  const idx = dest.indexOf(":");
  return idx === -1 ? name : dest.slice(idx + 1);
}
function validateDest(dest, names) {
  if (dest === "keychain")
    return;
  if (dest.startsWith("keychain:")) {
    if (!keychainService(names[0], dest))
      throw new Error("keychain: empty service name");
    return;
  }
  if (dest.startsWith("file:")) {
    if (!dest.slice(5))
      throw new Error("file: needs a path");
    if (names.length > 1)
      throw new Error("file: stores a single secret — use keychain (default) or env: for multiple");
    return;
  }
  if (dest.startsWith("env:")) {
    if (!dest.slice(4))
      throw new Error("env: needs a path");
    const bad = names.find((name) => !ENV_NAME.test(name));
    if (bad)
      throw new Error(`env: invalid variable name '${bad}'`);
    return;
  }
  throw new Error(`unknown --dest: '${dest}'`);
}
function dispatchStore(name, dest, value) {
  if (dest === "keychain" || dest.startsWith("keychain:")) {
    const service = keychainService(name, dest);
    return { label: `keychain:${service}`, retrieve: storeKeychain(service, value) };
  }
  if (dest.startsWith("file:"))
    return { label: dest, retrieve: storeFile(dest.slice(5), value) };
  if (dest.startsWith("env:"))
    return { label: dest, retrieve: storeEnv(name, dest.slice(4), value) };
  throw new ValidationError(`unknown --dest: '${dest}'`);
}
